{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "chrome",
      "node",
      "vite/client"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
